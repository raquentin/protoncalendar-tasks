{
  "manifest_version": 3,
  "name": "Proton Calendar Tasks",
  "version": "0.2.0",
  "description": "adds tasks/checkboxes to events in Proton Calendar",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://calendar.proton.me/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://calendar.proton.me/*"
      ],
      "js": [
        "lib/tasks.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "protoncalendar-tasks@raquentin.github.io",
      "strict_min_version": "109.0"
    }
  }
}
